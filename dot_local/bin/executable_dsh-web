#!/bin/sh
# Launch wrapper for the DeepSeek Harness web UI (used by dsh-web.service).
#
# Guard: mise only creates the shim when the dsh tool is installed, so on a
# host without dsh this exits quietly. The service also carries a
# ConditionPathExists on the shim; this is the belt to that suspender.
DSH="$HOME/.local/share/mise/shims/dsh"
[ -x "$DSH" ] || exit 0

# --no-open: serve only; don't pop a browser tab at every login.
# dsh (0.1.1-rc.2) refuses to bind anything but 127.0.0.1, so WireGuard
# access goes through dsh-web-proxy.socket instead (systemd-socket-proxyd
# on 10.137.42.2:3080 forwarding to loopback).
# --trusted-host: browsers arriving via the proxy send the WireGuard
# address as the Host header; the /api browser-trust fence must accept it
# or remote pages load but every API call is rejected.
exec "$DSH" web --no-open --trusted-host 10.137.42.2
