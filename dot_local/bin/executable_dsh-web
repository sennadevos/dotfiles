#!/bin/sh
# Launch wrapper for the DeepSeek Harness web UI (used by dsh-web.service).
#
# Guard: mise only creates the shim when the dsh tool is installed, so on a
# host without dsh this exits quietly. The service also carries a
# ConditionPathExists on the shim; this is the belt to that suspender.
DSH="$HOME/.local/share/mise/shims/dsh"
[ -x "$DSH" ] || exit 0

# --no-open: serve only; don't pop a browser tab at every login.
# Loopback only (dsh refuses other binds anyway). Remote access: SSH
# tunnel, e.g.  ssh -N -L 3080:127.0.0.1:3080 <this host>
exec "$DSH" web --no-open
