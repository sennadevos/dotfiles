[Desktop Entry]
Version=1.0
Encoding=UTF-8
Type=X-XFCE-Helper
X-XFCE-Category=TerminalEmulator
Name=kitty
Icon=utilities-terminal

# Absolute shim path, not a bare `kitty`: Thunar inherits niri's PATH, which
# does not include the mise shims — the same reason the Mod+T binding in
# niri/config.kdl spells the path out. A bare name silently fails to launch.
X-XFCE-Commands={{ .chezmoi.homeDir }}/.local/share/mise/shims/kitty
X-XFCE-CommandsWithParameter={{ .chezmoi.homeDir }}/.local/share/mise/shims/kitty -e %s
