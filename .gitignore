# Pre-existing chezmoi files (managed locally, not pushed to this repo)
/dot_bashrc
/dot_bashrc.d/
# Claude Code state stays local, but the user instructions and skills are real
# configuration shared with dsh through .chezmoitemplates/, so they travel
# with the dotfiles.
/dot_claude/*
!/dot_claude/CLAUDE.md.tmpl
!/dot_claude/skills/
# Same reasoning for the hooks and for the slice of settings.json chezmoi owns:
# both are configuration that has to reproduce on another machine, not state.
!/dot_claude/hooks/
!/dot_claude/modify_settings.json.tmpl
# ~/.claude.json is NOT ignored-but-untracked like the above: it is state and
# config mixed in one file, so modify_private_dot_claude.json.tmpl manages the
# single mcpServers key and passes the rest through.
/dot_config/private_kglobalshortcutsrc
# Ignore local-only .local/share state, but keep flatpak permission
# overrides in the repo: they are real configuration that must follow
# the dotfiles to other machines.
/dot_local/share/*
!/dot_local/share/flatpak/
# Chromium PWA launchers are hand-made (Chromium in the apps distrobox cannot
# run the host's xdg-desktop-menu integration), so nothing regenerates them.
!/dot_local/share/applications/
