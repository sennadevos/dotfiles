[Unit]
Description=WireGuard-facing listener for the DeepSeek Harness web UI
# Same guard as dsh-web.service: silent no-op on hosts without dsh.
ConditionPathExists=%h/.local/share/mise/shims/dsh

[Socket]
# dsh web refuses non-loopback binds, so the WireGuard side is served by a
# socket-activated proxy. Bound to the wg-sdv-access address only; firewalld
# additionally limits 3080/tcp to that interface (zone wg-sdv).
ListenStream=10.137.42.2:3080
# Allow binding while wg-sdv-access is down or not yet up.
FreeBind=true

[Install]
WantedBy=sockets.target
