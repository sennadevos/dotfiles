[Unit]
Description=DeepSeek Harness web UI
# Silent no-op on hosts where mise doesn't provide dsh: the condition makes
# systemd skip the start without marking the unit failed.
ConditionPathExists=%h/.local/share/mise/shims/dsh
After=graphical-session.target
PartOf=graphical-session.target

[Service]
ExecStart=%h/.local/bin/dsh-web
# mise shims on PATH so subagent providers can spawn `claude` etc.; the
# systemd user manager's default PATH doesn't include them.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
