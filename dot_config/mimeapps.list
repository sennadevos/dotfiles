# Explicit MIME defaults. This file is authoritative: entries here win over
# whatever the .desktop files in ~/.local/share/applications, the flatpak
# exports and /usr/share/applications happen to claim in their MimeType= lines.
#
# Without explicit pins, the winner among competing handlers is decided by
# directory precedence and the desktop cache — image/png alone had nine
# claimants (imv, gwenview, kolourpaint, gradia, okular-kimgio, Vivaldi x2, ...).
#
# Only [Default Applications] is declared on purpose. [Added Associations] is
# deliberately absent: those entries are what "Open With..." dialogs accumulate,
# and every alternative still shows up in the Open-With list via its own
# MimeType= line, so nothing is lost by not restating them here.
#
# Apply changes with:  update-desktop-database ~/.local/share/applications
# Check one type with: xdg-mime query default image/png

[Default Applications]

# --- Images -> imv (Wayland-native, ships with the host image) ---------------
# /usr/bin/imv is a wrapper that execs imv-wayland under Wayland.
# imv links librsvg/libwebp/libjxl/libheif, so it opens svg, webp, jxl, avif and
# heif even though imv.desktop's own MimeType= list doesn't advertise them.
image/png=imv.desktop
image/x-png=imv.desktop
image/jpeg=imv.desktop
image/jpg=imv.desktop
image/pjpeg=imv.desktop
image/gif=imv.desktop
image/bmp=imv.desktop
image/x-bmp=imv.desktop
image/tiff=imv.desktop
image/webp=imv.desktop
image/avif=imv.desktop
image/heif=imv.desktop
image/jxl=imv.desktop
image/svg+xml=imv.desktop
image/x-tga=imv.desktop
image/x-pcx=imv.desktop
image/x-xbitmap=imv.desktop
image/x-portable-anymap=imv.desktop
image/x-portable-bitmap=imv.desktop
image/x-portable-graymap=imv.desktop
image/x-portable-pixmap=imv.desktop

# --- Documents --------------------------------------------------------------
# PDFs open in a browser, but NOT the default one: nib is QtWebEngine without a
# PDF viewer enabled and doesn't claim application/pdf, so it would fail to
# render them. Vivaldi keeps this one type.
application/pdf=com.vivaldi.Vivaldi.desktop

# --- Web / browser -> nib ---------------------------------------------------
# nib is the default browser. Mod+B doesn't name it: open-default-browser
# resolves whatever is pinned here, so changing these lines moves the keybind
# too. Bare `nib` opens $NIB_HOME (default duckduckgo.com).
text/html=nib.desktop
application/xhtml+xml=nib.desktop
text/xml=nib.desktop
x-scheme-handler/http=nib.desktop
x-scheme-handler/https=nib.desktop
x-scheme-handler/about=nib.desktop
x-scheme-handler/unknown=nib.desktop

# --- Text -> neovim in a Ghostty window -------------------------------------
# nvim-ghostty.desktop spawns a GUI terminal; the packaged nvim.desktop is
# Terminal=true and doesn't reliably open from a file manager.
text/plain=nvim-ghostty.desktop
text/markdown=nvim-ghostty.desktop
text/x-tex=nvim-ghostty.desktop
text/csv=nvim-ghostty.desktop
application/x-zerosize=nvim-ghostty.desktop

# --- URL scheme handlers ----------------------------------------------------
# kdrive.desktop is lowercase; the old pin said kDrive.desktop and was dead.
x-scheme-handler/terminal=com.mitchellh.ghostty.desktop
x-scheme-handler/claude-cli=claude-code-url-handler.desktop
x-scheme-handler/kdrive=kdrive.desktop
x-scheme-handler/rpi-imager=com.raspberrypi.rpi-imager-uri-handler.desktop

# --- Deliberately NOT pinned ------------------------------------------------
# video/* and audio/* : no media player is installed on this system. The old
# pins pointed video/mp4 and audio/x-m4r at gwenview, an image viewer that
# cannot play either. Better no default than a wrong one -- install a player,
# then pin it here.
