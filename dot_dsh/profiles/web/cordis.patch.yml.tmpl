# User patch layer for the web profile (hot-reloaded by dsh).
# Note: a config override replaces the plugin's whole config object — restate
# every key you want to keep (idleTimeoutMs is the bundle default restated).
- id: product-subagents
  config:
    idleTimeoutMs: 600000
    # Chezmoi-managed roles (~/.dsh/roles) instead of the plugin's shipped
    # roles: the shipped `general` role runs Claude Code with
    # --dangerously-skip-permissions; ours cap at standard permissions.
    rolesDir: {{ .chezmoi.homeDir }}/.dsh/roles

# MCP servers — one dsh-mcp-client instance per server. Their tools reach the
# model as mcp__<serverName>__<toolName>.
- insert:
    # OpenRouter multimodal: vision, audio and video analysis/generation plus
    # model-catalog lookup (19 tools) via mcp__openrouter__*.
    - id: mcp-openrouter-multimodal
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: openrouter
        transport: stdio
        command: npx
        # Pinned deliberately: a bare `-y <pkg>` silently upgrades the server
        # under us on every spawn.
        args: ['-y', '@stabgan/openrouter-mcp-multimodal@4.6.2']
        env:
          # The key is NOT reachable as process.env here: it lives in the
          # credential store, and the subprocess seam additionally scrubs
          # credential-shaped variables out of the inherited environment. So
          # read it from the one file that holds it — a lookup rather than a
          # copy, so rotating the key stays a single edit in .credentials.yaml.
          #
          # `!!js` runs through `new Function`, i.e. global scope: there is no
          # `require` here (that throws and fails plugin load). process is
          # global, so reach the builtin through it instead.
          OPENROUTER_API_KEY: !!js >
            (process.getBuiltinModule('node:fs')
            .readFileSync(process.env.HOME + '/.dsh/.credentials.yaml', 'utf8')
            .match(/^\s*OPENROUTER_API_KEY:\s*(.+)$/m)?.[1] ?? '')
            .trim().replace(/^["']|["']$/g, '')

    # Chrome DevTools Protocol against the containerised Chromium that Mod+B and
    # the default-browser handler both open — 29 tools via mcp__chrome__*
    # (list_pages, navigate_page, click, fill_form, evaluate_script,
    # take_snapshot, list_network_requests, performance_start_trace, ...).
    - id: mcp-chrome-devtools
      name: '@deepseek-ai/dsh-mcp-client'
      config:
        serverName: chrome
        transport: stdio
        command: npx
        # Pinned deliberately, for the same reason as the server above.
        args:
          - '-y'
          - 'chrome-devtools-mcp@1.8.0'
          # Attach to the ALREADY-RUNNING browser rather than launching a fresh
          # one. This is the whole point: a launched instance would get its own
          # empty profile, while attaching reaches the live logged-in sessions.
          # The port is the one baked into the exported desktop entry; see
          # distrobox/distrobox.ini under [apps] for why those flags matter.
          - '--browserUrl'
          - 'http://127.0.0.1:9222'
          # Both of these default to ON and both phone home: usage statistics to
          # Google, and the performance tools send trace URLs to the CrUX API.
          # Off, since this browser holds real logged-in sessions.
          - '--usageStatistics=false'
          - '--no-performance-crux'
